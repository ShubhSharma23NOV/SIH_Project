rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // TEMPORARY: Allow all reads and writes for development/demo
    // WARNING: Change this before production deployment!
    match /{document=**} {
      allow read, write: if true;
    }
    
